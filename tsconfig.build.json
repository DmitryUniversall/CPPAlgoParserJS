{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": false,
        "rootDir": "src",
        "strict": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
